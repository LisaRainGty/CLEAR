# Normalize source and documentation line endings.
*.py text eol=lf
*.sh text eol=lf
*.md text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.tex text eol=lf
*.bib text eol=lf
*.tsv text eol=lf
*.log -diff

# The reviewer package intentionally versions raw, processed, and frozen data.
# Store large/binary scientific artifacts with Git LFS.  These rules come last
# so -text takes precedence for every object handled by LFS.
data/raw/** filter=lfs diff=lfs merge=lfs -text
data/index/** filter=lfs diff=lfs merge=lfs -text
data/processed/** filter=lfs diff=lfs merge=lfs -text
data/final/** filter=lfs diff=lfs merge=lfs -text
data/*.jsonl filter=lfs diff=lfs merge=lfs -text
data/arguments_only/*.jsonl filter=lfs diff=lfs merge=lfs -text
data/archives/*.tar.zst filter=lfs diff=lfs merge=lfs -text
embeddings/**/*.pt filter=lfs diff=lfs merge=lfs -text
paper/**/*.docx filter=lfs diff=lfs merge=lfs -text
paper/**/*.png filter=lfs diff=lfs merge=lfs -text
paper/**/*.pdf filter=lfs diff=lfs merge=lfs -text
